{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tinymind",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tinymind"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "tinymind-opennext-cache"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "www.forevermamba.work/*",
      "zone_name": "forevermamba.work"
    },
    {
      "pattern": "forevermamba.work/blog*",
      "zone_name": "forevermamba.work"
    },
    {
      "pattern": "forevermamba.work/thoughts*",
      "zone_name": "forevermamba.work"
    },
    {
      "pattern": "forevermamba.work/editor*",
      "zone_name": "forevermamba.work"
    },
    {
      "pattern": "forevermamba.work/login*",
      "zone_name": "forevermamba.work"
    },
    {
      "pattern": "forevermamba.work/api/*",
      "zone_name": "forevermamba.work"
    },
    {
      "pattern": "forevermamba.work/_next/*",
      "zone_name": "forevermamba.work"
    },
    {
      "pattern": "forevermamba.work/kobeshegu*",
      "zone_name": "forevermamba.work"
    },
    {
      "pattern": "forevermamba.work/manifest.json",
      "zone_name": "forevermamba.work"
    },
    {
      "pattern": "forevermamba.work/sitemap.xml",
      "zone_name": "forevermamba.work"
    },
    {
      "pattern": "forevermamba.work/robots.txt",
      "zone_name": "forevermamba.work"
    },
    {
      "pattern": "forevermamba.work/icon*",
      "zone_name": "forevermamba.work"
    },
    {
      "pattern": "forevermamba.work/favicon.ico*",
      "zone_name": "forevermamba.work"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://forevermamba.work",
    "NEXTAUTH_URL": "https://forevermamba.work",
    "NEXT_PUBLIC_BASE_URL": "https://forevermamba.work",
    "NEXT_PUBLIC_SITE_OWNER": "kobeshegu"
  }
}
